{
  "name": "kinnect-backend",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "api-gateway",
    "user-service",
    "location-service",
    "tag-service",
    "chat-service",
    "navigation-service",
    "video-service"
  ],
  "scripts": {
    "dev": "concurrently -n gw,user,loc,tag,chat,nav,vid -c cyan,green,yellow,magenta,blue,red,white \"npm run dev -w api-gateway\" \"npm run dev -w user-service\" \"npm run dev -w location-service\" \"npm run dev -w tag-service\" \"npm run dev -w chat-service\" \"npm run dev -w navigation-service\" \"npm run dev -w video-service\"",
    "db:migrate": "node db/migrate.js",
    "db:seed": "node db/seed.js",
    "test": "jest --forceExit",
    "test:unit": "jest tests/unit --forceExit",
    "test:integration": "jest tests/integration --forceExit",
    "test:coverage": "jest --coverage --forceExit"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "shared/lib/**/*.js"
    ],
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ],
    "coverageDirectory": "coverage",
    "testTimeout": 15000
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "jest": "^30.4.2",
    "jest-mock-extended": "^4.0.1",
    "supertest": "^7.2.2"
  }
}