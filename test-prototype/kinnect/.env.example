# ─────────────────────────────────────────────────────────
#  Kinnect — copy to .env and fill in your values
# ─────────────────────────────────────────────────────────

# Ports (defaults used by all services)
PORT_GATEWAY=3000
PORT_USER=3001
PORT_LOCATION=3002
PORT_TAG=3003
PORT_CHAT=3004
PORT_NAV=3005
PORT_VIDEO=3006

# JWT
JWT_SECRET=replace_with_a_long_random_secret_at_least_64_chars

# PostgreSQL — User DB
USER_DB_URL=postgresql://postgres:password@localhost:5432/kinnect_users

# PostgreSQL — Message DB  
MSG_DB_URL=postgresql://postgres:password@localhost:5432/kinnect_messages

# Redis
REDIS_URL=redis://localhost:6379

# Cloudflare R2  (S3-compatible)
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET=kinnect-media
R2_PUBLIC_URL=https://pub-xxxx.r2.dev  # your R2 public URL

# Google Maps (Navigation Service)
GOOGLE_MAPS_API_KEY=your_google_maps_key
